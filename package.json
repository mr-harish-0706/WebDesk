{
  "name": "webdesk",
  "productName": "WebDesk",
  "version": "1.0.0",
  "description": "Universal Linux Web Application Manager",
  "homepage": "https://github.com/webdesk/webdesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/webdesk/webdesk.git"
  },
  "bugs": {
    "url": "https://github.com/webdesk/webdesk/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/webdesk"
  },
  "author": {
    "name": "WebDesk Team",
    "email": "team@webdesk.app"
  },
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "desktop",
    "webapp",
    "linux",
    "browser",
    "webdesk",
    "productivity",
    "session-isolation"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dist-electron release",
    "build": "tsc && vite build && electron-builder",
    "rebuild": "npm run clean && npm run build",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.19",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
